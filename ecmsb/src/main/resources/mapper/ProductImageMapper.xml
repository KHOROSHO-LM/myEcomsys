<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.ecms.mapper.ProductImageMapper">
    <select id="selectByProductId" resultType="org.example.ecms.entity.ProductImage">
        SELECT id, product_id, image_url, sort, created_at
        FROM product_image
        WHERE product_id = #{productId}
        ORDER BY sort ASC, id ASC
    </select>
</mapper>
