<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.ecms.mapper.OrderLogMapper">
    <select id="selectByOrderId" resultType="org.example.ecms.entity.OrderLog">
        SELECT id, order_id, operator, action, remark, created_at
        FROM order_log
        WHERE order_id = #{orderId}
        ORDER BY id ASC
    </select>
</mapper>
