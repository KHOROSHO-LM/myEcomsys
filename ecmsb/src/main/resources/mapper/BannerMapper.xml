<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.ecms.mapper.BannerMapper">
    <select id="selectAll" resultType="org.example.ecms.entity.Banner">
        SELECT id, title, image_url, link_url, sort, status, created_at, updated_at
        FROM banner
        ORDER BY sort ASC, id ASC
    </select>
</mapper>
