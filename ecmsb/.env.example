# 复制为 .env 并按实际填写，启动前 source .env 或通过 docker --env-file 注入
# 本地开发可不设置，application.yml 内置了默认值；生产环境必须全部注入。

# 激活的 Spring profile：dev（默认）或 prod
SPRING_PROFILES_ACTIVE=dev

# 数据源
DB_URL=jdbc:mysql://localhost:3305/shop_admin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=root
DB_PASSWORD=

# JWT 签名密钥（建议使用 openssl rand -base64 48 生成）
JWT_SECRET=
# JWT 有效期（分钟）
JWT_EXPIRE=120
